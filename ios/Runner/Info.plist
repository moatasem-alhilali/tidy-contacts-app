<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Contact Clean</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Contact Clean</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Firebase disabled (not used currently): FCM background modes removed -->
	<!--
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	-->

	<!-- Required for connectivity_plus and some network plugins -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>This app uses your local network to detect connectivity status.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Required for connectivity on certain networks.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Required for connectivity on certain networks.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Required for connectivity on certain networks.</string>
	<key>NSContactsUsageDescription</key>
	<string>يحتاج التطبيق إلى الوصول لجهات الاتصال حتى يتمكن من تحليل الأرقام وتنظيفها مباشرة على جهازك.</string>

	<!-- Notification permissions -->
	<key>NSUserNotificationUsageDescription</key>
	<string>This app uses notifications to keep you updated with important information.</string>

	<!-- Photo picker (for image_picker or similar plugins) -->
	<key>NSCameraUsageDescription</key>
	<string>نحتاج لاستخدام الكاميرا حتى تتمكن من تصوير ورفع الصور داخل التطبيق.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>نحتاج للوصول لمعرض الصور حتى تتمكن من اختيار أو رفع صورة من جهازك.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>نحتاج لاستخدام الميكروفون في حال احتجت تسجيل صوت أثناء استخدام التطبيق.</string>

	<!-- Network security (required for most network plugins) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- Firebase disabled (not used currently) -->
	<!--
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	-->

	<!-- Notification settings (may not be needed for modern iOS, but safe to include) -->
	<key>UIUserNotificationSettings</key>
	<dict>
		<key>UIUserNotificationTypesAlert</key>
		<true/>
		<key>UIUserNotificationTypesBadge</key>
		<true/>
		<key>UIUserNotificationTypesSound</key>
		<true/>
	</dict>

	<!-- URL Launcher schemes for iOS -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>tel</string>
		<string>sms</string>
		<string>mailto</string>
	</array>
</dict>
</plist>
